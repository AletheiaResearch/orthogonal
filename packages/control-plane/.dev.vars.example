# Local development vars for the control-plane Cloudflare Worker.
# Copy to .dev.vars for `wrangler dev`.
# Bindings (KV/D1/DO/R2/service bindings) come from wrangler config, not here.
#
# In production these values are wired by OpenTofu
# (terraform/environments/production/workers-control-plane.tf).

# =============================================================================
# Config (plain-text vars)
# =============================================================================
# Deployment identifier used in logs and resource naming.
DEPLOYMENT_NAME=local
# Display name for user-visible UI, PR footers, and HTTP User-Agent headers.
APP_NAME=Open-Inspect
# GitHub App OAuth client ID (public half of the OAuth credentials).
GITHUB_CLIENT_ID=
# Base URL of the web app (for PR links). Local dev: http://localhost:3000
WEB_APP_URL=http://localhost:3000
# Base URL of this worker (for callbacks). Local dev: http://localhost:8787
WORKER_URL=http://localhost:8787
# Modal workspace name (for dashboard URLs).
MODAL_WORKSPACE=
# Modal environment name (for dashboard URLs).
MODAL_ENVIRONMENT=
# Modal environment web suffix (for endpoint URLs).
MODAL_ENVIRONMENT_WEB_SUFFIX=

# --- Optional config (sensible defaults applied when unset) ---
# Source control provider: "github" (default) or "gitlab".
# SCM_PROVIDER=github
# Cloudflare account ID (used to derive default worker URLs).
# CF_ACCOUNT_ID=
# "debug" | "info" | "warn" | "error"
LOG_LEVEL=info
# Sandbox inactivity timeout in ms (default: 600000 = 10 min).
# SANDBOX_INACTIVITY_TIMEOUT_MS=600000
# Max processing time before auto-fail in ms (default: 5400000 = 90 min).
# EXECUTION_TIMEOUT_MS=5400000

# =============================================================================
# Secrets
# =============================================================================
# GitHub App OAuth client secret (pairs with GITHUB_CLIENT_ID).
GITHUB_CLIENT_SECRET=
# Encryption key for stored OAuth/user tokens. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Encryption key for per-repo secrets. Generate: openssl rand -base64 32
REPO_SECRETS_ENCRYPTION_KEY=
# Shared HMAC secret for callbacks to/from the bots and web app.
# Must match INTERNAL_CALLBACK_SECRET in github-bot, slack-bot, linear-bot, and orto.
# Generate: openssl rand -base64 32
INTERNAL_CALLBACK_SECRET=

# GitHub App credentials (for git operations and the /repos endpoint).
GITHUB_APP_ID=
# PKCS#8 PEM. Convert with:
#   openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt -in key.pem -out key-pkcs8.pem
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# Optional JSON map of GitHub owner login -> installation ID (multi-org installs).
# GITHUB_APP_INSTALLATION_MAP={"other-org":"87654321"}

# Modal API credentials and shared auth secret.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Shared secret for authenticating with Modal endpoints.
# Must match MODAL_API_SECRET in modal-infra. Generate: openssl rand -hex 32
MODAL_API_SECRET=

# Optional: only set if the slack-bot is deployed. Enables agent-initiated
# chat.postMessage calls. Shared with the slack-bot worker's SLACK_BOT_TOKEN.
# SLACK_BOT_TOKEN=

# Optional: GitLab credentials (only when SCM_PROVIDER=gitlab).
# GITLAB_ACCESS_TOKEN=
# GITLAB_NAMESPACE=
