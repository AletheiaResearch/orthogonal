# --- PayloadCMS / Neon (Vercel integration, "CHRONICLES" prefix) ---
# Pooled Neon endpoint — used by the app at runtime. Injected by the Neon
# integration on Vercel; set it manually for local dev.
CHRONICLES_POSTGRES_URL=postgres://user:password@host-pooler.neon.tech/dbname?sslmode=require
# Direct (non-pooled) Neon endpoint — point `payload migrate` at this if the
# pooler rejects DDL (PgBouncer transaction pooling).
CHRONICLES_POSTGRES_URL_NON_POOLING=postgres://user:password@host.neon.tech/dbname?sslmode=require
# Payload encryption secret (generate a long random string).
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- Site ---
# Canonical base URL (no trailing slash). Used for live preview, canonical URLs, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret guarding the /preview route used by Payload live preview.
PREVIEW_SECRET=change-me-to-a-random-string
# Set to "true" to allow search engines to index the site. Leave unset/false
# during the "coming soon" phase to keep /blog out of search results.
SITE_INDEXABLE=false

# --- Cloudflare R2 (media storage via @payloadcms/storage-s3) ---
# Uploads go to this R2 bucket via the S3-compatible API. Files are served from
# the bucket's public custom domain (R2_PUBLIC_URL), NOT proxied through Payload.
# Leave R2_BUCKET unset to disable the storage plugin and fall back to local
# disk storage.
# Unset => storage plugin disabled (local disk).
R2_BUCKET=
# Optional: public base URL the R2 bucket is served from (no trailing slash).
# This is the custom domain bound to the bucket in the Cloudflare R2 dashboard.
# Defaults to https://chronicles.orto.sh when unset.
R2_PUBLIC_URL=
# S3 API endpoint used for uploads only (not file serving).
# Format: https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2 API token credentials (S3-compatible access keys).
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
