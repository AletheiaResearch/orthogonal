# Root environment variables for local tooling.
# Copy to .env (gitignored) and fill in the values below.
#
# Per-service env files live alongside each package/app:
#   apps/orto/.env.example, apps/landing/.env.example,
#   packages/modal-infra/.env.example, and packages/*/.dev.vars.example
#   (Cloudflare Workers — copy to .dev.vars for `wrangler dev`).

# License key for the ReactBits shadcn registry. Used as the Bearer token when
# adding/updating registry components (packages/ui and apps/orto components.json).
# From: https://reactbits.dev/
REACTBITS_LICENSE_KEY=
